# TaskHive environment variables — copy to .env (never commit real values).
# All of these are OPTIONAL for local dev; sensible defaults apply.
# On Render, set them in the dashboard under your service → Environment.

# ---- Server ----
PORT=3000                       # Render injects PORT automatically; leave unset there.
NODE_ENV=production             # optional; only affects log verbosity

# ---- Data storage (SQLite relational DB) ----
TASKHIVE_DATA_DIR=./data        # durable directory holding taskhive.sqlite.
                                # On a paid Render plan with a disk, use e.g. /var/data/taskhive.
                                # NOTE: the free plan has NO persistent disk — data resets on
                                # redeploy/spin-down and the demo workspace is re-seeded.

# ---- Cookies / HTTPS ----
TASKHIVE_COOKIE_SECURE=1        # Set to 1 on Render (HTTPS-only session cookie). Leave unset locally over http://localhost.
TASKHIVE_TRUST_PROXY=1          # Set to 1 behind Render's proxy so rate limiting keys off X-Forwarded-For.

# ---- CORS ----
TASKHIVE_ALLOWED_ORIGINS=       # Comma-separated extra origins allowed to call /api
                                # (e.g. https://taskhive-4vsl.onrender.com). Empty = same-origin only,
                                # which is correct for the single-service deployment.

# ---- Demo workspace ----
TASKHIVE_DEMO_PASSWORD=password # Password for the seeded demo account(s). CHANGE THIS in production.
TASKHIVE_SEED_DEMO=1            # Set to 0 to disable seeding the demo workspace entirely.

# ---- Not used (informational) ----
# DATABASE_URL                  # If you later move to hosted Postgres, the server logs a notice
                                # that this build uses SQLite and ignores DATABASE_URL.
